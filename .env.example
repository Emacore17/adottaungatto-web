APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
API_GLOBAL_RATE_LIMIT_PER_MINUTE=1200
# false in locale (nessun proxy). Dietro un reverse-proxy/ingress usare il
# numero di hop fidati (es. 1 per un solo ingress) oppure i CIDR dei proxy.
# Non usare "true" in produzione: l'intera catena X-Forwarded-For verrebbe
# considerata fidata e l'IP client sarebbe falsificabile (bypass rate limit).
API_TRUST_PROXY=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000

POSTGRES_DB=adottaungatto
POSTGRES_USER=adottaungatto
POSTGRES_PASSWORD=adottaungatto
DATABASE_URL=postgresql://adottaungatto:adottaungatto@localhost:5432/adottaungatto

REDIS_URL=redis://localhost:6379

ISTAT_MUNICIPALITIES_XLSX_URL=https://www.istat.it/storage/codici-unita-amministrative/Elenco-comuni-italiani.xlsx
ISTAT_ADMIN_BOUNDARIES_ZIP_URL=https://www.istat.it/storage/cartografia/confini_amministrativi/generalizzati/2026/Limiti01012026_g.zip

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
NEXT_PUBLIC_S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=adottaungatto-local
NEXT_PUBLIC_S3_BUCKET=adottaungatto-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Locale: Mailpit (nessuna auth). Produzione: provider transazionale reale.
# Esempio Resend -> MAIL_HOST=smtp.resend.com, MAIL_PORT=465, MAIL_SECURE=true,
#   MAIL_USER=resend, MAIL_PASS=<RESEND_API_KEY>, MAIL_FROM=no-reply@<dominio-verificato>
# Esempio Brevo  -> MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587, MAIL_SECURE=false,
#   MAIL_USER=<login-smtp>, MAIL_PASS=<smtp-key>
# In produzione l'app rifiuta MAIL_HOST localhost/smtp.invalid e MAIL_USER/MAIL_PASS vuoti.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@adottaungatto.local
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
PHONE_VERIFICATION_TTL_MINUTES=10
# Verifica telefono via SMS: off finche' non c'e' un provider SMS reale (es.
# Twilio). Off => contatto telefonico disabilitato, si pubblica con email.
# In local/test resta comunque sempre attiva (codice via log/devCode).
PHONE_VERIFICATION_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LIMIT_MULTIPLIER=1
RATE_LIMIT_WINDOW_MULTIPLIER=1
OBSERVABILITY_ALERT_ERROR_RATE_THRESHOLD=0.05
OBSERVABILITY_ALERT_IN_FLIGHT_THRESHOLD=50
OBSERVABILITY_ALERT_MIN_REQUESTS=20
OBSERVABILITY_ALERT_P95_MS_THRESHOLD=1000

TRUSTED_ACTION_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
