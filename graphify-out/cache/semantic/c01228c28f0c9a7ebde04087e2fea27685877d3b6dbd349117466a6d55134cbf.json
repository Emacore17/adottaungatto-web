{"nodes": [{"id": "docs_search_full_text_ranking_postgres_v1_ranking", "label": "postgres-v1 Ranking (ts_rank_cd + distance + freshness + quality + trust + engagement)", "file_type": "concept", "source_file": "docs/search-full-text-ranking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "text_score applies only when q is present; distance_score only with lat/lng within radiusKm; listings without a search document remain searchable via inline fallback but get 0 on non-textual boosts until document refresh."}, {"id": "docs_search_full_text_ranking_listing_search_documents", "label": "listing_search_documents Denormalized Search Table", "file_type": "concept", "source_file": "docs/search-full-text-ranking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A denormalized table is preferred over a materialized view in the initial phase to allow controlled refreshes from worker or application triggers; refresh hooks fire on moderation decisions, image processing and like/unlike."}, {"id": "docs_search_full_text_ranking_trigram_fallback", "label": "Trigram Fallback for Empty Full-Text First Page", "file_type": "concept", "source_file": "docs/search-full-text-ranking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When q is present, page is 1 and full-text returns zero rows, a second pg_trgm similarity query runs with explicit filters unchanged, declared via meta.expansion type trigram_text / reason empty_full_text."}, {"id": "docs_search_full_text_ranking_listing_promotions", "label": "listing_promotions Declared Sponsored Slot", "file_type": "concept", "source_file": "docs/search-full-text-ranking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Active promotions never modify rankingVersion or the organic score: they occupy a declared slot ordered before organic results, and only when the promoted listing matches the applied filters."}, {"id": "docs_search_full_text_ranking_quality_score", "label": "Listing Quality Score (image/description/health-field weights)", "file_type": "concept", "source_file": "docs/search-full-text-ranking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The quality score is persisted in the search document to avoid heavy recomputation at query time."}, {"id": "docs_search_full_text_ranking_search_benchmark_cli", "label": "Search Benchmark CLI (pnpm search:benchmark)", "file_type": "concept", "source_file": "docs/search-full-text-ranking.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_search_full_text_ranking_postgres_v1_ranking", "target": "docs_search_full_text_ranking_listing_search_documents", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/search-full-text-ranking.md", "source_location": null, "weight": 1.0}, {"source": "docs_search_full_text_ranking_trigram_fallback", "target": "docs_search_full_text_ranking_listing_search_documents", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/search-full-text-ranking.md", "source_location": null, "weight": 1.0}, {"source": "docs_search_full_text_ranking_quality_score", "target": "docs_search_full_text_ranking_listing_search_documents", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/search-full-text-ranking.md", "source_location": null, "weight": 1.0}, {"source": "docs_search_full_text_ranking_search_benchmark_cli", "target": "docs_search_full_text_ranking_listing_search_documents", "relation": "references", "confidence": "EXTRACTED", "confidence_sco