{"nodes": [{"id": "docs_authz_authz_strategy", "label": "Authentication, Authorization and Roles Strategy", "file_type": "document", "source_file": "docs/authz.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_authz_bearer_session_auth", "label": "Bearer Token Sessions", "file_type": "rationale", "source_file": "docs/authz.md", "source_location": "Autenticazione - Sessioni", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Initial sessions are bearer tokens stored hashed in the database, rotated after login and sensitive actions, revocable server-side, with absolute and inactivity expiry; HttpOnly/Secure/SameSite cookies planned for full browser sessions."}, {"id": "docs_authz_rbac_ownership", "label": "RBAC with Ownership Checks", "file_type": "concept", "source_file": "docs/authz.md", "source_location": "Autorizzazione", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RBAC for general roles (anonymous, registered, professional, moderator, admin) combined with per-resource ownership checks; every admin/moderator action generates an audit log."}, {"id": "docs_authz_redis_rate_limiting", "label": "Redis Fixed-Window Rate Limiting", "file_type": "concept", "source_file": "docs/authz.md", "source_location": "Rate limit auth iniziale", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed windows with hashed application keys combine per-IP limits with per-email/token/user/operator limits; returns 429 with reason and retryAfterSeconds; RATE_LIMIT_ENABLED and multiplier env vars tune limits per environment without code changes."}, {"id": "docs_authz_single_use_hashed_tokens", "label": "Single-Use Hashed Tokens (Email Verification / Password Reset)", "file_type": "concept", "source_file": "docs/authz.md", "source_location": "Verifica email / Recupero password", "source_url"