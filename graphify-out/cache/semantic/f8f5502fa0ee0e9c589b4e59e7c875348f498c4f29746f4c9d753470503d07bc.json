{"nodes": [{"id": "docs_moderation_listing_moderation_states", "label": "Moderation vs Lifecycle Listing States", "file_type": "rationale", "source_file": "docs/moderation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moderation status (draft/pending_review/approved/rejected/suspended) is deliberately separated from lifecycle status (draft/published/expired/adopted/deleted); a listing is public only when approved AND published AND not expired AND not soft-deleted."}, {"id": "docs_moderation_moderation_workflow", "label": "Listing Moderation Workflow", "file_type": "concept", "source_file": "docs/moderation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_moderation_moderation_queue", "label": "Pending Review Moderation Queue (/moderation, /moderation/queue)", "file_type": "concept", "source_file": "docs/moderation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Queue requires moderator/admin role, applies Redis rate limits, supports claim to avoid concurrent double decisions, and the frontend is server-rendered, noindex, inside a separate internal layout with authorization always enforced by the API (403)."}, {"id": "docs_moderation_reported_queue", "label": "Reported Listings Queue (GET /moderation/listings/reported)", "file_type": "concept", "source_file": "docs/moderation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_moderation_moderation_decisions", "label": "Moderation Decisions (approve/reject/suspend, claim, comments)", "file_type": "concept", "source_file": "docs/moderation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every decision requires a reason, is accepted only from the assigned moderator on claimed cases, closes linked reports (approve\u2192dismissed, reject/suspend\u2192resolved), sends opt-out-respecting emails, and always creates in-app notifications."}, {"id": "docs_moderation_user_reports", "label": "User Reports (POST /reports/listings/:listingId)", "file_type": "concept", "source_file": "docs/moderation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A new report opens or reuses an open case; if the same user already has a linked report on the same open case, the API returns the existing report instead of creating a duplicate to avoid noise."}, {"id": "docs_moderation_moderation_persistence", "label": "Moderation Persistence (moderation_cases, moderation_actions, reports)", "file_type": "concept", "source_file": "docs/moderation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "moderation_cases drives the operational queue, moderation_actions is the audit trail for open/assign/comment/report/decide; for production the audit must become immutable, searchable and linked to operational alerts."}, {"id": "docs_moderation_automatic_checks", "label": "Automatic Pre-Moderation Checks", "file_type": "concept", "source_file": "docs/moderation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_moderation_moderation_workflow", "target": "docs_moderation_listing_moderation_states", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/moderation.md", "source_location": null, "weight": 1.0}, {"source": "docs_moderation_moderation_workflow", "target": "docs_moderation_moderation_queue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/moderation.md", "source_location": null, "weight": 1.0}, {"source": "docs_moderation_moderation