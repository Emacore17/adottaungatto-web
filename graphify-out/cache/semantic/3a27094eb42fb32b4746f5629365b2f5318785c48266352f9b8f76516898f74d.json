{"nodes": [{"id": "docs_backend_stack_backend_stack_choice", "label": "Backend Stack Choice", "file_type": "document", "source_file": "docs/backend-stack.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_backend_stack_typescript_end_to_end", "label": "TypeScript End-to-End", "file_type": "rationale", "source_file": "docs/backend-stack.md", "source_location": "Motivazioni", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frontend is already bound to Next.js/TypeScript; using TypeScript in the backend reduces context switching, enables shared type/validation packages, and makes the project more manageable for a coding agent."}, {"id": "docs_backend_stack_drizzle_orm", "label": "Drizzle ORM", "file_type": "concept", "source_file": "docs/backend-stack.md", "source_location": "Motivazioni", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps the model close to SQL with TypeScript typing and does not over-abstract PostgreSQL/PostGIS features needed for full-text search, extensions, GIN/GiST indexes and geographic queries."}, {"id": "docs_backend_stack_redis_bullmq", "label": "Redis + BullMQ", "file_type": "concept", "source_file": "docs/backend-stack.md", "source_location": "Motivazioni", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redis serves short cache, rate limiting and queues; BullMQ remains the target for async jobs (image processing, email, notifications, places import) but is not integrated yet - the worker uses explicit commands without a persistent queue."}], "edges": [{"source": "docs_backend_stack_backend_stack_choice", "target": "docs_backend_stack_typescript_end_to_end", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/backend-stack.md", "source_location": "Motivazioni", "weight": 1.0}, {"source": "doc