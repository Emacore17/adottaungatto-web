{"nodes": [{"id": "docs_frontend_nextjs_shadcn_guidelines_frontend_guidelines", "label": "Next.js and shadcn/ui Frontend Guidelines", "file_type": "document", "source_file": "docs/frontend-nextjs-shadcn-guidelines.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_frontend_nextjs_shadcn_guidelines_server_first_components", "label": "Server-First Component Split", "file_type": "concept", "source_file": "docs/frontend-nextjs-shadcn-guidelines.md", "source_location": "Server e Client Components", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pages, layouts and list/detail components stay Server Components; 'use client' only on small interactive leaves (forms, toggles, carousels); indexable public pages must be server-rendered and client components receive already-reduced serializable data."}, {"id": "docs_frontend_nextjs_shadcn_guidelines_typed_api_client", "label": "Centralized Typed API Client", "file_type": "concept", "source_file": "docs/frontend-nextjs-shadcn-guidelines.md", "source_location": "Data access", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All fetch is centralized in apps/web/lib/api with env-based base URL, timeouts, typed error handling and UI-ready ApiResult.message without raw HTTP details; the browser never talks directly to the database or private storage, and bearer tokens are never exposed to the client."}, {"id": "docs_frontend_nextjs_shadcn_guidelines_route_groups", "label": "Route Groups (public/auth/account/admin)", "file_type": "concept", "source_file": "docs/frontend-nextjs-shadcn-guidelines.md", "source_location": "Struttura target", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_frontend_nextjs_shadcn_guidelines_seo_first", "label": "SEO as Product Requirement", "file_type": "concept", "source_file": "docs/frontend-nextjs-shadcn-g