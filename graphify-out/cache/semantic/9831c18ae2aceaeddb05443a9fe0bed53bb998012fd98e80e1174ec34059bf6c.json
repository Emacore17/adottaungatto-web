{"nodes": [{"id": "docs_frontend_brand_redesign_brand_redesign", "label": "Frontend Brand Redesign", "file_type": "document", "source_file": "docs/frontend-brand-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_frontend_brand_redesign_warm_trust_direction", "label": "Warm Trust Visual Direction", "file_type": "rationale", "source_file": "docs/frontend-brand-redesign.md", "source_location": "Direzione visuale", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Warm light surfaces with deep teal as primary, coral as emotional accent, amber and olive for highlights and states; exact logo colors are used only as accents because they lack contrast for small text on light backgrounds; the site must stay an operational marketplace, not a decorative landing page."}, {"id": "docs_frontend_brand_redesign_global_brand_tokens", "label": "Global Brand Tokens in globals.css", "file_type": "concept", "source_file": "docs/frontend-brand-redesign.md", "source_location": "Palette target", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Color tokens are defined once in packages/ui/src/styles/globals.css and mapped to shadcn semantic tokens; components must use semantic classes (bg-background, bg-primary, etc.) instead of raw colors."}, {"id": "docs_frontend_brand_redesign_sample_page_gate", "label": "Sample Page First, Approval-Gated Rollout", "file_type": "rationale", "source_file": "docs/frontend-brand-redesign.md", "source_location": "Processo di implementazione", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implement only the home sample page first, stop, and require explicit user approval before applying the visual system site-wide, keeping the site usable at every step and avoiding an unreviewed mega-refactor. Phase 2 rollout was completed after approval on 13 May 2026."}], "edges": [{"source": "docs_frontend_brand_redesign_brand_redesign", "target": "docs_frontend_brand_redesign_warm_trust_direction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/frontend-brand-redesign.md", "source_location": "Direzione visuale", "weight": 1.0}, {"source": "docs_frontend_brand_redesign_brand_redesign", "target": "docs_frontend_brand_redesign_global_brand_tokens", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/frontend-brand-redesign.md", "source_location": "Palette target", "weight": 1.0}, {"source": "docs_frontend_brand_redesign_brand_redesign", "target": "docs_frontend_brand_redesign_sample_page_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/frontend-brand-redesign.md", "source_location": "Processo di implementazione", "weight": 1.0}, {"source": "docs_frontend_brand_redesign_brand_redesign", "target": "docs_frontend_nextjs_shadcn_guidelines_frontend_guidelines", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/frontend-brand-redesign.md", "source_location": "Fase 0: preparazione", "weight": 1.0}, {"source": "docs_frontend_brand_redesign_global_brand_tokens", "target": "docs_frontend_nextjs_shadcn_guidelines_frontend_guidelines", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/frontend-brand-redesign.md", "source_location": "Palette target (semantic token rule shared with guidelines)", "weight": 1.0}], "hyperedges": []}