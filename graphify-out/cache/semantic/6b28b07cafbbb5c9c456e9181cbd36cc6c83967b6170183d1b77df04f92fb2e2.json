{"nodes": [{"id": "docs_deploy_strategy_deploy_strategy", "label": "Deploy Strategy", "file_type": "document", "source_file": "docs/deploy-strategy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_deploy_strategy_azure_cloudflare_stack", "label": "Azure Italy North + Cloudflare Stack", "file_type": "concept", "source_file": "docs/deploy-strategy.md", "source_location": "Stack scelto", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Azure covers Key Vault, Container Apps, managed Postgres with PostGIS, an Italian region, OIDC with GitHub and future growth; Cloudflare reduces cost and risk on DNS/CDN/admin access, and R2 avoids egress costs on public assets."}, {"id": "docs_deploy_strategy_dev_online_environment", "label": "dev-online Environment", "file_type": "concept", "source_file": "docs/deploy-strategy.md", "source_location": "Ambienti - dev-online", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Online developer environment close to production, deployed on merge to develop: synthetic/demo data only (never plain production dumps), developer allowlist or Cloudflare Access, same providers as production where cheap."}, {"id": "docs_deploy_strategy_protected_production_deploy", "label": "Protected Production Deploy", "file_type": "concept", "source_file": "docs/deploy-strategy.md", "source_location": "Ambienti - production / deploy-prod.yml", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Production requires PR develop->master, manual approval on GitHub Environment production, backup/PITR verification, controlled migrations, post-deploy smoke and release annotation; destructive migrations must never be rolled back automatically."}, {"id": "docs_deploy_strategy_ci_cd_workflows", "label": "CI/CD Workflows (ci.yml, deploy-dev.yml, deploy-prod.yml, rollback-prod.yml)", "file_type": "concept", "source_file": "docs/deploy-strategy.md", "source_location": "CI/CD", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_deploy_strategy_admin_host_isolation", "label": "Admin Host-Level Isolation", "file_type": "concept", "source_file": "docs/deploy-strategy.md", "source_location": "Admin/moderazione", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admin/moderation is treated as an internal application: dedicated admin subdomain, Cloudflare Access with MFA and email allowlist, dedicated WAF/rate limits, noindex, short sessions; before public go-live /moderation must answer only from admin.* hosts while public domains return 404/403 or redirect."}, {"id": "docs_deploy_strategy_secrets_oidc", "label": "Secrets via Key Vault and GitHub OIDC", "file_type": "concept", "source_file": "docs/deploy-strategy.md", "source_location": "Segreti e configurazione", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runtime secrets live in Azure Key Vault, pipelines authenticate via OIDC federated credentials instead of static cloud passwords, and secrets are never committed to the repository."}], "edges": [{"source": "docs_deploy_strategy_deploy_strategy", "target": "docs_deploy_strategy_azure_cloudflare_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deploy-strategy.md", "source_location": "Stack scelto", "weight": 1.0}, {"source": "docs_deploy_strategy_deploy_strategy", "target": "docs_deploy_strategy_dev_online_environment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deploy-strategy.md", "source_location": "Ambienti", "weight": 1.0}, {"source": "docs_deploy_strategy_deploy_strategy", "target": "docs_deploy_strategy_protected_production_deploy", "relation": "references", "confidence": "EXTRACTED", "confidence_scor