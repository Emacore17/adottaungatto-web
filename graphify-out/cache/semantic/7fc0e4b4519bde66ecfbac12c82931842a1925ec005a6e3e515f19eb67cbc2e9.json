{"nodes": [{"id": "docs_superpowers_plans_2026_05_15_dev_online_first_deploy_dev_online_environment", "label": "Dev-Online Environment (Azure Italy North + Cloudflare)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-05-15-dev-online-first-deploy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Container Apps, ACR, PostgreSQL, Key Vault and Redis on Azure Italy North with Cloudflare DNS/Access/R2; APP_ENV=production even in dev-online to exercise non-local cookies/headers/env validations; demo or synthetic data only, never production dumps; user handles logins/billing/DNS/secrets, agent automates the rest."}, {"id": "docs_superpowers_plans_2026_05_15_dev_online_first_deploy_deploy_dev_workflow", "label": "deploy-dev.yml GitHub Actions Workflow", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-05-15-dev-online-first-deploy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merge to develop is the standard trigger: build/push web+api+worker images to ACR, read runtime secrets from Key Vault, run migrations, optional demo seed, deploy Container Apps, then remote smoke."}, {"id": "docs_superpowers_plans_2026_05_15_dev_online_first_deploy_remote_smoke", "label": "Remote Smoke Script (pnpm smoke:remote)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-05-15-dev-online-first-deploy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "release:smoke stays local-only; dev-online uses a separate remote smoke that checks health/readiness/listings/web pages without contacting Mailpit and without creating mutative data."}, {"id": "docs_superpowers_plans_2026_05_15_dev_online_first_deploy_azure_oidc_federation", "label": "GitHub-to-Azure OIDC Federation", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-05-15-dev-online-first-deploy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Federated credential scoped to the dev-online GitHub Environment lets Actions log into Azure without a client secret; minimal roles: Contributor on the resource group, AcrPush on the registry, Key Vault Secrets User on the vault."}, {"id": "docs_superpowers_plans_2026_05_15_dev_online_first_deploy_admin_host_guard", "label": "Admin Host Guard for /moderation (ADMIN_ALLOWED_HOSTS)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-05-15-dev-online-first-deploy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In production-like environments the web proxy returns 404 for /moderation unless the request host is in ADMIN_ALLOWED_HOSTS (admin/admin-dev subdomains), hiding the internal area from the public domain."}], "edges": [{"source": "docs_superpowers_plans_2026_05_15_dev_online_first_deploy_deploy_dev_workflow", "target": "docs_superpowers_plans_2026_05_15_dev_online_first_deploy_remote_smoke", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-05-15-dev-online-first-deploy.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_05_15_dev_online_first_deploy_deploy_dev_workflow", "target": "docs_superpowers_plans_2026_05_15_dev_online_first_deploy_azure_oidc_federation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-05-15-dev-online-first-deploy.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_05_15_dev_online_first_deploy_deploy_dev_workflow", "target": "docs_superpowers_plans_2026_05_15_dev_online_first_deploy_admin_host_guard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0,